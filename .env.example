APP_NAME=Lineage_RAG_System
ENVIRONMENT=dev
LOG_LEVEL=INFO
INTERFACE_MODE=fastapi
RETRIEVAL_INDEX_PATH=data/processed
MCP_EVIDENCE_DISCLOSURE_ENABLED=false
# Tunnel-client-only inputs. Do not place the real control-plane key in .env.
CONTROL_PLANE_API_KEY=
OPENAI_TUNNEL_ID=
AUDIT_JOURNAL_ENABLED=false
AUDIT_SINK_BACKEND=hmac_jsonl
AUDIT_JOURNAL_PATH=data/exports/audit/api_audit.jsonl
AUDIT_HMAC_KEY=
EMBEDDED_DOCS_DIR=data/docs_embedded
RAW_CODE_DIR=data/raw_code
CODE_SNAPSHOTS_DIR=data/code_snapshots
CODE_STAGING_DIR=data/staging/code
CODE_INDEXES_DIR=data/indexes/code
INGESTION_SOURCE_POLICY_PATH=config/ingestion_sources.toml
CODE_ANALYSIS_POLICY_PATH=config/code_analysis.toml
CODE_PARSE_TIMEOUT_SECONDS=120
CODE_PARSE_MEMORY_LIMIT_MIB=1024
CODE_PARSE_MAX_SEGMENT_CHARACTERS=500
CODE_RETRIEVAL_MAX_UNIT_CHARACTERS=6000
CODE_RETRIEVAL_OVERLAP_CHARACTERS=400

ARTIFACT_VERSION=v1
INDEX_VERSION=fsrag_v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-5-mini

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=functional_specs
CODE_MODES_ENABLED=false
CODE_QDRANT_LOCAL_PATH=data/qdrant_code_local
CODE_QDRANT_COLLECTION_NAME=code_custom_r1_v2
CODE_INDEX_ARTIFACT_PATH=data/staging/code_embeddings/fci-custom-r1-b1c79c6dc2c5/code_index_text_embedding_3_large_v1/code_index_artifact.json
CODE_ANALYSIS_DIRECTORY=data/staging/code/fci-custom-r1-b1c79c6dc2c5/plsql_antlr_4_13_2_analysis_v12
FDD_CODE_LINEAGE_ARTIFACT_PATH=data/staging/fdd_code_lineage/neo_aml_v1/reviewed_lineage_artifact.json
FDD_GENERATION=functional_specs_v5
QDRANT_VECTOR_SIZE=3072
QDRANT_LOCAL_PATH=data/qdrant_local

RETRIEVAL_MODE=hybrid
RETRIEVAL_MIN_TOP_SCORE=0.30
HYBRID_DENSE_WEIGHT=0.40
HYBRID_LEXICAL_WEIGHT=0.60
HYBRID_CANDIDATE_LIMIT=10

LLM_INPUT_COST_PER_1K_TOKENS=0.0
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0
