{
  "schema_version": "1.0",
  "runtime": "Python 3.12 with uv",
  "install_command": [
    "uv",
    "sync",
    "--locked",
    "--no-dev"
  ],
  "preflight_command": [
    "uv",
    "run",
    "--locked",
    "--no-dev",
    "python",
    "scripts/check_deployment_preflight.py"
  ],
  "processes": {
    "api": [
      "uv",
      "run",
      "--locked",
      "--no-dev",
      "uvicorn",
      "app.api.main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000"
    ],
    "ui": [
      "uv",
      "run",
      "--locked",
      "--no-dev",
      "streamlit",
      "run",
      "app/ui/streamlit_app.py",
      "--server.address",
      "127.0.0.1",
      "--server.port",
      "8501"
    ],
    "mcp_stdio": [
      "powershell",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/run_mcp_stdio.ps1"
    ]
  },
  "mcp_stdio": {
    "process_owner": "tunnel-client",
    "working_directory": ".",
    "interface_mode": [
      "mcp",
      "both"
    ],
    "required_application_environment": [
      "INTERFACE_MODE",
      "MCP_EVIDENCE_DISCLOSURE_ENABLED",
      "OPENAI_API_KEY"
    ],
    "control_plane_key": {
      "name": "CONTROL_PLANE_API_KEY",
      "owner": "tunnel-client parent process only",
      "must_not_be_inherited_by_mcp_child": true
    },
    "startup_contract": "The child performs local configuration preflight before tools register; this manifest does not inject environment variables."
  },
  "mutable_state": {
    "bundled": false,
    "required_external_paths": [
      "data/processed",
      "data/qdrant_local",
      "data/exports",
      "data/exports/audit/api_audit.jsonl",
      "data/conversations.sqlite3"
    ]
  },
  "service_manager": "Select an Oracle-approved native supervisor after the target runtime is confirmed."
}
