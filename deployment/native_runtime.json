{
  "schema_version": "1.0",
  "runtime": "Python 3.12 with uv",
  "install_command": [
    "uv",
    "sync",
    "--locked",
    "--no-dev"
  ],
  "preflight_command": [
    "uv",
    "run",
    "--locked",
    "--no-dev",
    "python",
    "scripts/check_deployment_preflight.py"
  ],
  "processes": {
    "api": [
      "uv",
      "run",
      "--locked",
      "--no-dev",
      "uvicorn",
      "app.api.main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000"
    ],
    "ui": [
      "uv",
      "run",
      "--locked",
      "--no-dev",
      "streamlit",
      "run",
      "app/ui/streamlit_app.py",
      "--server.address",
      "127.0.0.1",
      "--server.port",
      "8501"
    ]
  },
  "mutable_state": {
    "bundled": false,
    "required_external_paths": [
      "data/processed",
      "data/qdrant_local",
      "data/exports",
      "data/conversations.sqlite3"
    ]
  },
  "service_manager": "Select an Oracle-approved native supervisor after the target runtime is confirmed."
}
